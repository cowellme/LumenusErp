POSTGRES_USER=lumenus
POSTGRES_PASSWORD=change-me
APP_PORT=8080
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-me-123!
# API-токен (Bearer) для /api/lumenus и ключи LLM; пустое значение отключает функцию
API_TOKEN=
OPENROUTER_API_KEY=
# Модель OpenRouter для калькулятора и FAQ-ассистента; пусто = anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=
# Лимиты ИИ (секция AiLimits; в docker-compose не проброшены, по умолчанию подходят для прода).
# Чтобы изменить, добавить в environment сервиса app, например: AiLimits__CalculatorPerHour: 5
#   AiLimits__CalculatorPerHour=5      AiLimits__CalculatorPerDay=15      AiLimits__CalculatorGlobalPerDay=300
#   AiLimits__FaqPerHour=20            AiLimits__FaqPerDay=60             AiLimits__FaqGlobalPerDay=1000
DEEPSEEK_API_KEY=
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_FOLDER_ID=

# HTTPS через Caddy (сервис caddy, профиль proxy). ACME_EMAIL — контакт для Let's Encrypt (пусто = info@lumenustech.ru).
SITE_DOMAIN=lumenustech.ru
ACME_EMAIL=
# Адрес, на котором приложение публикует порт. На проде за Caddy: 127.0.0.1
APP_BIND=0.0.0.0
# В проде (shared/.env): COMPOSE_PROFILES=proxy, APP_BIND=127.0.0.1, APP_PORT=8080
# COMPOSE_PROFILES=proxy
