@page "/"
@rendermode InteractiveServer
<PageTitle>LunenusUam — Корпоративные AI-системы</PageTitle>

@* ======================================================================== *@
@*  HERO                                                                   *@
@* ======================================================================== *@
<section class="bg-white border-bottom border-dark border-2 py-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <p class="font-monospace small fw-bold text-muted text-uppercase letter-spacing mb-3">
                    LLM &middot; RAG &middot; ON-PREMISE
                </p>
                <h1 class="display-4 fw-extrabold lh-1 mb-4 border-0 p-0">
                    Проектируем безопасные AI-системы для корпоративных данных
                </h1>
                <p class="lead text-muted mb-4" style="max-width: 560px;">
                    Связываем большие языковые модели с инфраструктурой предприятия —
                    локально, с шифрованием персональных данных, без передачи информации
                    в публичные облака.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#competencies" class="btn btn-dark btn-lg rounded-0 text-uppercase fw-semibold px-4 text-decoration-none">
                        Компетенции и услуги
                    </a>
                    <a href="#problems" class="btn btn-outline-dark btn-lg rounded-0 text-uppercase fw-semibold px-4 text-decoration-none">
                        С какими задачами приходят
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  STATS                                                                   *@
@* ======================================================================== *@
<section class="bg-light border-bottom border-dark border-2 py-4">
    <div class="container">
        <div class="row text-center g-0">
            @foreach (var stat in stats)
            {
                <div class="col-6 col-md-3 border-end border-dark border-2 @(stat == stats.Last() ? "border-end-0" : "")">
                    <div class="py-4">
                        <span class="d-block display-5 fw-extrabold font-monospace mb-2">@stat.Value</span>
                        <span class="d-block font-monospace small fw-semibold text-muted text-uppercase">@stat.Label</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  COMPETENCIES                                                            *@
@* ======================================================================== *@
<section id="competencies" class="bg-white py-5">
    <div class="container">
        <div class="mb-5">
            <p class="font-monospace small fw-bold text-muted text-uppercase mb-2">УСЛУГИ</p>
            <h2 class="display-6 fw-extrabold mb-2 border-0 p-0">Ключевые компетенции</h2>
            <p class="text-muted">Backend-разработка, AI-интеграция, информационная безопасность</p>
        </div>
        <div class="row g-4">
            @foreach (var comp in competencies)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="border border-dark border-2 p-4 h-100 bg-white">
                        <h3 class="h5 fw-bold mb-3">@comp.Title</h3>
                        <p class="small text-muted mb-0 lh-base">@comp.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  TECH STACK                                                              *@
@* ======================================================================== *@
<section class="bg-light py-5">
    <div class="container">
        <div class="mb-5">
            <p class="font-monospace small fw-bold text-muted text-uppercase mb-2">ИНСТРУМЕНТЫ</p>
            <h2 class="display-6 fw-extrabold mb-2 border-0 p-0">Стек технологий</h2>
            <p class="text-muted">Инструменты, с которыми работаем ежедневно</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var tech in techStack)
            {
                <span class="border border-dark border-2 px-3 py-1 font-monospace small fw-semibold bg-white">@tech.Name</span>
            }
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  PROBLEMS                                                                *@
@* ======================================================================== *@
<section id="problems" class="bg-white py-5">
    <div class="container">
        <div class="mb-5">
            <p class="font-monospace small fw-bold text-muted text-uppercase mb-2">КЕЙСЫ</p>
            <h2 class="display-6 fw-extrabold mb-2 border-0 p-0">С какими задачами к нам приходят</h2>
        </div>
        <div class="row g-4">
            @foreach (var problem in problems)
            {
                <div class="col-lg-6">
                    <div class="border border-dark border-2 border-start border-5 p-4 h-100 bg-white">
                        <p class="mb-3 lh-base">@problem.Text</p>
                        <p class="font-monospace small fw-bold text-muted text-uppercase mb-0">
                            — @problem.Label
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  CTA                                                                     *@
@* ======================================================================== *@
<section class="bg-light border-top border-bottom border-dark border-2 py-5">
    <div class="container text-center">
        <h2 class="display-6 fw-extrabold mb-3 border-0 p-0">
            Готовы обсудить внедрение AI в вашу инфраструктуру?
        </h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 560px;">
            Спроектируем архитектуру, развернём LLM в вашем контуре, подключим к учётным системам.
            Без компромиссов по безопасности.
        </p>
        <a href="/calculator" class="btn btn-dark btn-lg rounded-0 text-uppercase fw-semibold px-5 py-3 text-decoration-none">
            Рассчитать стоимость проекта
        </a>
    </div>
</section>

@* ======================================================================== *@
@*  FOOTER                                                                  *@
@* ======================================================================== *@
<footer class="bg-white py-4">
    <div class="container text-center">
        <span class="font-monospace fw-bold small">LUNENUS<span class="fw-extrabold text-muted">UAM</span></span>
        <span class="text-secondary mx-2">/</span>
        <span class="small text-muted">Корпоративные AI-системы &copy; @DateTime.Now.Year</span>
    </div>
</footer>

@code {
    private readonly List<StatItem> stats = new()
    {
        new("100%", "On‑Premise"),
        new("24/7", "Мониторинг"),
        new("0", "Утечек в LLM"),
        new("50+", "Интеграций"),
    };

    private readonly List<Competency> competencies = new()
    {
        new("RAG‑системы", "Конвейеры «поиск → извлечение → генерация» для анализа документов, переписок и аудиозаписей с привязкой к базе знаний предприятия."),
        new("MCP‑серверы и API‑шлюзы", "Серверная инфраструктура на .NET (REST API), связывающая бизнес‑приложения заказчика с языковыми моделями."),
        new("Локальное развёртывание LLM", "Полный цикл: от подбора оборудования до Docker-оркестрации и CI/CD. Для организаций с закрытым контуром."),
        new("Шифрование и защита ПДн", "Автоматическое выявление и маскирование персональных данных до передачи в LLM, пост‑проверка результатов."),
        new("Гибридные архитектуры", "Экономичная модель: безопасность на своей стороне, сложный интеллект — у облачных провайдеров через Open Router."),
        new("Интеграция в учётные системы", "Соединение LLM‑конвейеров с Pyrus, CRM, BPM через REST API с автообновлением полей задач."),
        new("Мониторинг коммуникаций", "Выявление утечек, коррупционных схем, автоматическая группировка персонала по рискам на основе анализа переписок и звонков."),
        new("Специализированные AI‑модели", "Проверка документов, машинный перевод, генерация служебных записок и сводок под конкретные бизнес‑процессы."),
    };

    private readonly List<TechItem> techStack = new()
    {
        new("Python"), new(".NET 9"), new("ASP.NET Core"), new("Docker / Compose"),
        new("REST API"), new("Open Web UI"), new("Open Router"), new("RAG"),
        new("LLM (локальные)"), new("LLM (облачные)"), new("Pyrus API"),
        new("PostgreSQL"), new("CI/CD"),
    };

    private readonly List<Problem> problems = new()
    {
        new("Утечки данных", "«У нас более 100 сотрудников и большой объём переписок и звонков — необходимо понимать, кто допускает утечку информации, а кто просто неэффективен.»"),
        new("Закрытый контур", "«Требуется внедрить AI-агента, но корпоративные данные запрещено отправлять в открытые LLM из соображений безопасности.»"),
        new("Автоматизация", "«Документы должны проверяться, переводиться, а задачи в Pyrus — обновляться автоматически, без участия операторов.»"),
        new("On‑Premise LLM", "«Необходим сервер для LLM, развёрнутый непосредственно в нашем контуре, с шифрованием всех персональных данных из Bitrix24 перед передачей в облачную модель.»"),
    };

    private sealed record StatItem(string Value, string Label);
    private sealed record Competency(string Title, string Description);
    private sealed record TechItem(string Name);
    private sealed record Problem(string Label, string Text);
}