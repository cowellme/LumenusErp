@page "/"
@rendermode InteractiveServer
<PageTitle>@PageTitleText</PageTitle>
<SeoMeta Path="/" Title="@PageTitleText" Description="@PageDescription" JsonLd="@JsonLd" />

@* ======================================================================== *@
@*  HERO                                                                   *@
@* ======================================================================== *@
<section class="hero" aria-labelledby="hero-title">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-9 col-xl-8">
                <p class="eyebrow">
                    LLM &middot; RAG &middot; ON-PREMISE
                </p>
                <h1 id="hero-title" class="hero__title">
                    Проектируем безопасные AI-системы для корпоративных данных
                </h1>
                <p class="hero__lead">
                    Связываем большие языковые модели с инфраструктурой предприятия —
                    локально, с шифрованием персональных данных, без передачи информации
                    в публичные облака.
                </p>
                <div class="hero__actions">
                    <a href="#competencies" class="btn btn-dark btn-lg">
                        Компетенции и услуги
                    </a>
                    <a href="#problems" class="btn btn-outline-dark btn-lg">
                        С какими задачами приходят
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  STATS                                                                   *@
@* ======================================================================== *@
<section class="section section--tight" aria-label="Показатели">
    <div class="container">
        <div class="stats">
            @foreach (var stat in stats)
            {
                <div class="stat">
                    <span class="stat__value">@stat.Value</span>
                    <span class="stat__label">@stat.Label</span>
                </div>
            }
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  COMPETENCIES                                                            *@
@* ======================================================================== *@
<section id="competencies" class="section" aria-labelledby="competencies-title">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">УСЛУГИ</p>
            <h2 id="competencies-title" class="section-title">Ключевые компетенции</h2>
            <p class="text-muted mb-0">Backend-разработка, AI-интеграция, информационная безопасность</p>
        </div>
        <div class="row g-4">
            @foreach (var comp in competencies)
            {
                <div class="col-lg-3 col-md-6">
                    <article class="card-x p-4 h-100">
                        <h3 class="card-x__title">@comp.Title</h3>
                        <p class="small text-muted mb-0 lh-base">@comp.Description</p>
                    </article>
                </div>
            }
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  TECH STACK                                                              *@
@* ======================================================================== *@
<section id="stack" class="section section--alt" aria-labelledby="stack-title">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">ИНСТРУМЕНТЫ</p>
            <h2 id="stack-title" class="section-title">Стек технологий</h2>
            <p class="text-muted mb-0">Инструменты, с которыми работаем ежедневно</p>
        </div>
        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
            @foreach (var tech in techStack)
            {
                <li><span class="chip">@tech.Name</span></li>
            }
        </ul>
    </div>
</section>

@* ======================================================================== *@
@*  PROBLEMS                                                                *@
@* ======================================================================== *@
<section id="problems" class="section" aria-labelledby="problems-title">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">КЕЙСЫ</p>
            <h2 id="problems-title" class="section-title">С какими задачами к нам приходят</h2>
        </div>
        <div class="row g-4">
            @foreach (var problem in problems)
            {
                <div class="col-lg-6">
                    <article class="card-x card-x--quote p-4 h-100">
                        <p class="mb-3 lh-base">@problem.Text</p>
                        <p class="eyebrow mb-0">
                            — @problem.Label
                        </p>
                    </article>
                </div>
            }
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  CTA                                                                     *@
@* ======================================================================== *@
<section class="section section--alt" aria-labelledby="cta-title">
    <div class="container text-center">
        <h2 id="cta-title" class="section-title mb-3">
            Готовы обсудить внедрение AI в вашу инфраструктуру?
        </h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 560px;">
            Спроектируем архитектуру, развернём LLM в вашем контуре, подключим к учётным системам.
            Без компромиссов по безопасности.
        </p>
        <a href="/calculator" class="btn btn-dark btn-lg px-5">
            Рассчитать стоимость проекта
        </a>
    </div>
</section>

@code {
    private const string PageTitleText = "LumenusTech — Корпоративные AI-системы";
    private const string PageDescription =
        "Проектируем безопасные AI-системы для корпоративных данных: RAG, локальное развёртывание LLM, шифрование персональных данных, интеграция в учётные системы.";

    // JSON-LD: организация, сайт и список услуг (по тем же данным, что выводятся на странице)
    private object JsonLd => new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "Organization",
                ["@id"] = SiteInfo.BaseUrl + "/#organization",
                ["name"] = SiteInfo.Name,
                ["url"] = SiteInfo.BaseUrl + "/",
                ["email"] = SiteInfo.Email,
                ["logo"] = SiteInfo.Url("/favicon.png"),
                ["description"] = PageDescription,
                ["sameAs"] = new[] { SiteInfo.TelegramUrl },
            },
            new Dictionary<string, object>
            {
                ["@type"] = "WebSite",
                ["@id"] = SiteInfo.BaseUrl + "/#website",
                ["name"] = SiteInfo.Name,
                ["url"] = SiteInfo.BaseUrl + "/",
                ["inLanguage"] = "ru",
                ["publisher"] = new Dictionary<string, object> { ["@id"] = SiteInfo.BaseUrl + "/#organization" },
            },
            new Dictionary<string, object>
            {
                ["@type"] = "ItemList",
                ["name"] = "Ключевые компетенции и услуги",
                ["itemListElement"] = competencies.Select((c, i) => new Dictionary<string, object>
                {
                    ["@type"] = "ListItem",
                    ["position"] = i + 1,
                    ["item"] = new Dictionary<string, object>
                    {
                        ["@type"] = "Service",
                        ["name"] = c.Title,
                        ["description"] = c.Description,
                        ["provider"] = new Dictionary<string, object> { ["@id"] = SiteInfo.BaseUrl + "/#organization" },
                    },
                }).ToList(),
            },
        },
    };

    private readonly List<StatItem> stats = new()
    {
        new("100%", "On‑Premise"),
        new("24/7", "Мониторинг"),
        new("0", "Утечек в LLM"),
        new("50+", "Интеграций"),
    };

    private readonly List<Competency> competencies = new()
    {
        new("RAG‑системы", "Конвейеры «поиск → извлечение → генерация» для анализа документов, переписок и аудиозаписей с привязкой к базе знаний предприятия."),
        new("MCP‑серверы и API‑шлюзы", "Серверная инфраструктура на .NET (REST API), связывающая бизнес‑приложения заказчика с языковыми моделями."),
        new("Локальное развёртывание LLM", "Полный цикл: от подбора оборудования до Docker-оркестрации и CI/CD. Для организаций с закрытым контуром."),
        new("Шифрование и защита ПДн", "Автоматическое выявление и маскирование персональных данных до передачи в LLM, пост‑проверка результатов."),
        new("Гибридные архитектуры", "Экономичная модель: безопасность на своей стороне, сложный интеллект — у облачных провайдеров через Open Router."),
        new("Интеграция в учётные системы", "Соединение LLM‑конвейеров с Pyrus, CRM, BPM через REST API с автообновлением полей задач."),
        new("Мониторинг коммуникаций", "Выявление утечек, коррупционных схем, автоматическая группировка персонала по рискам на основе анализа переписок и звонков."),
        new("Специализированные AI‑модели", "Проверка документов, машинный перевод, генерация служебных записок и сводок под конкретные бизнес‑процессы."),
    };

    private readonly List<TechItem> techStack = new()
    {
        new("Python"), new(".NET 9"), new("ASP.NET Core"), new("Docker / Compose"),
        new("REST API"), new("Open Web UI"), new("Open Router"), new("RAG"),
        new("LLM (локальные)"), new("LLM (облачные)"), new("Pyrus API"),
        new("PostgreSQL"), new("CI/CD"),
    };

    private readonly List<Problem> problems = new()
    {
        new("Утечки данных", "«У нас более 100 сотрудников и большой объём переписок и звонков — необходимо понимать, кто допускает утечку информации, а кто просто неэффективен.»"),
        new("Закрытый контур", "«Требуется внедрить AI-агента, но корпоративные данные запрещено отправлять в открытые LLM из соображений безопасности.»"),
        new("Автоматизация", "«Документы должны проверяться, переводиться, а задачи в Pyrus — обновляться автоматически, без участия операторов.»"),
        new("On‑Premise LLM", "«Необходим сервер для LLM, развёрнутый непосредственно в нашем контуре, с шифрованием всех персональных данных из Bitrix24 перед передачей в облачную модель.»"),
    };

    private sealed record StatItem(string Value, string Label);
    private sealed record Competency(string Title, string Description);
    private sealed record TechItem(string Name);
    private sealed record Problem(string Label, string Text);
}