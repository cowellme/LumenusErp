@page "/tasks/calls/{Id:guid}"
@using System.Security.Claims
@using LumenusErp.Data
@using LumenusErp.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@inject CallService Calls
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Созвон — LumenusTech</PageTitle>

<section class="hero hero--sm">
    <div class="container">
        <p class="eyebrow">TASKS</p>
        <h1 class="hero__title mb-2" style="overflow-wrap:anywhere;">@(call?.FileName ?? "Созвон")</h1>
        <a href="/tasks/calls" class="font-monospace small fw-bold text-dark">&larr; К созвонам</a>
        <TasksTabs Active="calls" />
    </div>
</section>

<section class="section section--tight">
    <div class="container" style="max-width: 820px;">
        @if (!loaded)
        {
            <p class="text-muted">Загрузка…</p>
        }
        else if (call is null)
        {
            <p class="text-muted">Не найдено.</p>
        }
        else
        {
            <p class="mb-3">
                <span class="pill @(call.Status == CallRecording.StatusFailed ? "pill--solid" : "pill--outline")">@StatusLabel</span>
                @if (CallService.IsActive(call.Status))
                {
                    <span class="small text-muted ms-1">Страница обновляется сама.</span>
                }
            </p>

            @if (!string.IsNullOrEmpty(call.Error))
            {
                <div class="alert @(call.Status == CallRecording.StatusFailed ? "alert-danger" : "alert-warning")" role="alert">@call.Error</div>
            }
            @if (error is not null)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }
            @if (info is not null)
            {
                <div class="alert alert-success" role="status">@info</div>
            }

            @if (call.Suggestions.Count > 0)
            {
                <h2 class="h5 mb-3">Найденные задачи</h2>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-3">
                    @foreach (var s in call.Suggestions)
                    {
                        <li class="card-x p-3" @key="s.Id">
                            <div class="d-flex align-items-start gap-3">
                                @if (s.TaskItemId is null)
                                {
                                    <input type="checkbox" class="form-check-input mt-2 flex-shrink-0" style="width:1.25rem;height:1.25rem;"
                                           checked="@checkedIds.Contains(s.Id)" @onchange="e => SetChecked(s.Id, (bool)e.Value!)"
                                           aria-label="Добавить в трекер" />
                                }
                                <div class="flex-grow-1" style="min-width:0;">
                                    @if (s.TaskItemId is null)
                                    {
                                        <input class="form-control" maxlength="@TaskService.MaxTitle" aria-label="Название задачи"
                                               value="@titles[s.Id]" @oninput="e => titles[s.Id] = e.Value?.ToString() ?? string.Empty" />
                                    }
                                    else
                                    {
                                        <div class="fw-semibold" style="overflow-wrap:anywhere;">@s.Title</div>
                                        <div class="small mt-1"><span class="pill pill--tag">добавлена</span> <a href="/tasks" class="text-dark">к задачам</a></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(s.SourceText))
                                    {
                                        <div class="small text-muted mt-1" style="overflow-wrap:anywhere;">«@s.SourceText»</div>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                @if (call.Suggestions.Any(s => s.TaskItemId is null))
                {
                    <button type="button" class="btn btn-dark mb-4" disabled="@(busy || checkedIds.Count == 0)" @onclick="AddAsync">Добавить отмеченные в трекер</button>
                }
            }
            else if (call.Status == CallRecording.StatusDone && string.IsNullOrEmpty(call.Error))
            {
                <p class="text-muted">Задач в разговоре не найдено.</p>
            }

            @if (!string.IsNullOrEmpty(call.Transcript))
            {
                <details class="card-x p-3">
                    <summary class="fw-semibold">Транскрипт</summary>
                    <div class="mt-2">
                        <button type="button" class="btn btn-outline-dark btn-sm mb-2" @onclick="CopyAsync">@(copied ? "Скопировано" : "Копировать")</button>
                        <p class="small mb-0" style="white-space:pre-wrap;overflow-wrap:anywhere;">@call.Transcript</p>
                    </div>
                </details>
            }
        }
    </div>
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    private string? ownerId;
    private CallRecording? call;
    private bool loaded, busy, copied, disposed;
    private string? error, info;
    // Отмеченные подсказки и редактируемые названия переживают опрос статуса (список перечитывается)
    private readonly HashSet<Guid> checkedIds = new();
    private readonly Dictionary<Guid, string> titles = new();
    private readonly HashSet<Guid> known = new();
    private Timer? timer;

    private string StatusLabel => call!.Status switch
    {
        CallRecording.StatusQueued => "В очереди",
        CallRecording.StatusProcessing => string.IsNullOrEmpty(call.Stage) ? "Обработка" : call.Stage,
        CallRecording.StatusDone => "Готово",
        _ => "Ошибка",
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        ownerId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (ownerId is null) return;
        call = await Calls.GetAsync(ownerId, Id);
        loaded = true;
        if (call is not null)
        {
            foreach (var s in call.Suggestions)
            {
                // Новые подсказки по умолчанию отмечены (если ещё не добавлены); правки пользователя не затираем
                if (known.Add(s.Id))
                {
                    titles[s.Id] = s.Title;
                    if (s.TaskItemId is null) checkedIds.Add(s.Id);
                }
                if (s.TaskItemId is not null) checkedIds.Remove(s.Id);
            }
        }
        UpdatePolling();
    }

    private void UpdatePolling()
    {
        var active = call is not null && CallService.IsActive(call.Status);
        if (active && timer is null && !disposed)
        {
            timer = new Timer(_ => _ = InvokeAsync(PollAsync), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
        else if (!active && timer is not null)
        {
            timer.Dispose();
            timer = null;
        }
    }

    private async Task PollAsync()
    {
        if (disposed) return;
        try
        {
            await ReloadAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            // Цепь могла закрыться или БД мигнула: следующий тик попробует снова
        }
    }

    private void SetChecked(Guid id, bool on)
    {
        if (on) checkedIds.Add(id);
        else checkedIds.Remove(id);
    }

    private async Task AddAsync()
    {
        error = info = null;
        if (ownerId is null || call is null) return;
        var picked = new Dictionary<Guid, string>();
        foreach (var s in call.Suggestions.Where(s => s.TaskItemId is null && checkedIds.Contains(s.Id)))
        {
            var title = TaskService.NormalizeTitle(titles[s.Id]);
            if (title is null)
            {
                error = $"Название задачи: 1–{TaskService.MaxTitle} символов.";
                return;
            }
            picked[s.Id] = title;
        }
        if (picked.Count == 0) return;

        busy = true;
        try
        {
            var r = await Calls.AddToTrackerAsync(ownerId, Id, picked);
            if (r.Errors.Count > 0) error = string.Join(" ", r.Errors);
            var done = r.Added + r.Existing;
            if (done > 0) info = $"Добавлено в трекер: {done}." + (r.Existing > 0 ? $" Из них уже были в трекере: {r.Existing}." : "");
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CopyAsync()
    {
        if (call?.Transcript is null) return;
        copied = await JS.InvokeAsync<bool>("lmnTasks.copy", call.Transcript);
        if (!copied) error = "Не удалось скопировать: выделите текст и скопируйте вручную.";
    }

    public void Dispose()
    {
        disposed = true;
        timer?.Dispose();
    }
}
