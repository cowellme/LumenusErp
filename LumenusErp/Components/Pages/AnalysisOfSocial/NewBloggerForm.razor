@using Shared.Models
@inject AosDbContext AosDbContext
<div class="border border-dark border-2 p-4">
    <div class="row g-3 align-items-end">
        @* Платформа — кнопки-тумблеры *@
        <div class="col-md-4">
            <label class="font-monospace small fw-bold text-muted text-uppercase mb-2 d-block">Платформа</label>
            <div class="d-flex gap-0">
                <button type="button"
                        class="btn @(newBlogger.Social == Social.Instagram ? "btn-dark" : "btn-outline-dark") rounded-1 rounded-end-0 flex-fill fw-semibold text-uppercase"
                        style="font-size:0.75rem; letter-spacing:0.05em;"
                        @onclick="ToggleSocialInstagram">
                    Instagram
                </button>
                <button type="button"
                        class="btn @(newBlogger.Social == Social.Telegram ? "btn-dark" : "btn-outline-dark") rounded-1 rounded-start-0 flex-fill fw-semibold text-uppercase"
                        style="font-size:0.75rem; letter-spacing:0.05em;"
                        @onclick="ToggleSocialTelegram">
                    Telegram
                </button>
            </div>
        </div>

        @* Имя *@
        <div class="col-md-4">
            <label for="blogger-name" class="font-monospace small fw-bold text-muted text-uppercase mb-2">Имя</label>
            <input type="text" id="blogger-name"
                   class="form-control rounded-1 border-dark border-2"
                   placeholder="Имя блогера"
                   @bind="newBlogger.Name" />
        </div>

        @* Ссылка *@
        <div class="col-md-4">
            <label for="blogger-url" class="font-monospace small fw-bold text-muted text-uppercase mb-2">Ссылка</label>
            <input type="text" id="blogger-url"
                   class="form-control rounded-1 border-dark border-2"
                   placeholder="@(newBlogger.Social == Social.Instagram ? "https://www.instagram.com/..." : "@nickname")"
                   @bind="newBlogger.Url" />
        </div>

        @* Кнопка сохранения *@
        <div class="col-12">
            <button type="button"
                    class="btn btn-dark rounded-1 fw-bold text-uppercase px-5"
                    style="letter-spacing:0.06em;"
                    @onclick="SaveBlogger">
                Сохранить
            </button>
        </div>
    </div>
</div>


@code {
    private Blogger newBlogger = new() {Social = Social.Instagram};

    private async Task SaveBlogger()
    {
        await AosDbContext.Bloggers.AddAsync(newBlogger);
        await AosDbContext.SaveChangesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleSocialInstagram()
    {
        newBlogger.Social = Social.Instagram;
        StateHasChanged();
    }

    private void ToggleSocialTelegram()
    {
        newBlogger.Social = Social.Telegram;
        StateHasChanged();
    }

}
