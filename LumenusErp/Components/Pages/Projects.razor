@page "/projects"
@using LumenusErp.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
<PageTitle>@PageTitleText</PageTitle>
<SeoMeta Path="/projects" Title="@PageTitleText" Description="@PageDescription" JsonLd="@JsonLd" />

@* ======================================================================== *@
@*  HERO                                                                   *@
@* ======================================================================== *@
<section class="hero hero--sm" aria-labelledby="projects-title">
    <div class="container">
        <p class="eyebrow">РЕЕСТР</p>
        <h1 id="projects-title" class="hero__title mb-3">Архив проектов</h1>
        <p class="hero__lead mb-0" style="max-width: 600px;">
            Завершённые и текущие работы. От локальных RAG-систем до гибридных AI-платформ
            для организаций с закрытым контуром.
        </p>
    </div>
</section>

@* ======================================================================== *@
@*  TABLE                                                                   *@
@* ======================================================================== *@
<section class="section section--tight" aria-labelledby="registry-title">
    <h2 id="registry-title" class="visually-hidden">Реестр проектов</h2>
    <div class="container">

        @* ── Table ─────────────────────────────────────────────────── *@
        <div class="table-responsive table-card">
            <table class="table table-borderless mb-0 align-middle" style="min-width: 800px;">
                <caption class="visually-hidden">Реестр проектов LumenusTech: заказчик, проект, направление, год и статус</caption>
                <thead>
                    <tr>
                        <th scope="col" class="font-monospace small text-muted text-uppercase fw-bold px-3 py-3" style="width:16%;">Заказчик</th>
                        <th scope="col" class="font-monospace small text-muted text-uppercase fw-bold px-3 py-3" style="width:28%;">Проект</th>
                        <th scope="col" class="font-monospace small text-muted text-uppercase fw-bold px-3 py-3" style="width:14%;">Направление</th>
                        <th scope="col" class="font-monospace small text-muted text-uppercase fw-bold px-3 py-3" style="width:8%;">Год</th>
                        <th scope="col" class="font-monospace small text-muted text-uppercase fw-bold px-3 py-3" style="width:12%;">Статус</th>
                        <th scope="col" class="font-monospace small text-muted text-uppercase fw-bold px-3 py-3 text-center" style="width:5%;"><span class="visually-hidden">Подробнее</span></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < projects.Count; i++)
                    {
                        var p = projects[i];
                        var detailId = "project-detail-" + i;

                        @* Раскрытие строк — js/table-rows.js (без цепи Blazor, страница статическая) *@
                        <tr data-row-toggle
                            style="cursor:pointer;"
                            tabindex="0"
                            role="button"
                            aria-expanded="false"
                            aria-controls="@detailId">
                            <td class="font-monospace small fw-semibold px-3 py-3">@p.Client</td>
                            <td class="small px-3 py-3 fw-semibold">@p.Title</td>
                            <td class="font-monospace small fw-semibold px-3 py-3">@p.Direction</td>
                            <td class="font-monospace small fw-semibold px-3 py-3">@p.Year</td>
                            <td class="px-3 py-3">
                                @if (p.Status == ProjectStatus.InProgress)
                                {
                                    <span class="pill pill--outline">
                                        @p.Status.ToUpperInvariant()
                                    </span>
                                }
                                else
                                {
                                    <span class="pill pill--solid">
                                        @p.Status.ToUpperInvariant()
                                    </span>
                                }
                            </td>
                            <td class="text-center px-3 py-3">
                                <a href="/projects/@p.Slug" class="font-monospace pe-3 link-dark fw-bold small" style="display:inline-block;">Подробнее</a>
                            </td>
                        </tr>
                        <tr id="@detailId" class="row-open" hidden>
                            <td colspan="6" class="p-0">
                                <div class="p-4 p-md-5">
                                    <div class="row g-4">
                                        <div class="col-lg-8">
                                            <p class="mb-3 lh-base">@p.Summary</p>
                                            <p class="small text-muted mb-0 font-monospace">
                                                @p.Duration &middot; @p.Team
                                            </p>
                                        </div>
                                        <div class="col-lg-4">
                                            <div class="ps-lg-4 detail-side d-flex flex-column gap-4 h-100">

                                                <div>
                                                    <p class="eyebrow mb-2">Технологии</p>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var tag in p.Tags)
                                                        {
                                                            <span class="pill pill--tag">
                                                                @tag
                                                            </span>
                                                        }
                                                    </div>
                                                </div>

                                                <a href="/projects/@p.Slug" class="font-monospace small fw-bold text-dark mt-auto pt-2">
                                                    Карточка проекта &rarr;
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── Footer stats ──────────────────────────────────────────── *@
        <div class="d-flex flex-wrap gap-2 mt-3 font-monospace small text-muted">
            <span>Всего записей: <strong class="text-dark">@projects.Count</strong></span>
            <span class="text-secondary">/</span>
            <span>Завершено: <strong class="text-dark">@projects.Count(p => p.Status == ProjectStatus.Done)</strong></span>
            <span class="text-secondary">/</span>
            <span>В работе: <strong class="text-dark">@projects.Count(p => p.Status == ProjectStatus.InProgress)</strong></span>
            <span class="text-secondary">/</span>
            <span>Последнее обновление: <strong class="text-dark">@(projects.Count > 0 ? projects.Max(p => p.UpdatedAt).ToString("dd.MM.yyyy") : "—")</strong></span>
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  CTA                                                                     *@
@* ======================================================================== *@
<section class="section section--alt" aria-labelledby="cta-title">
    <div class="container text-center">
        <p class="eyebrow">НОВАЯ ЗАПИСЬ</p>
        <h2 id="cta-title" class="section-title mb-3">Добавить проект в реестр</h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 560px;">
            Спроектируем архитектуру под вашу задачу — с фокусом на безопасность и работу в закрытом контуре.
        </p>
        <a href="/calculator" class="btn btn-dark btn-lg px-5">
            Рассчитать стоимость
        </a>
    </div>
</section>

@code {
    private const string PageTitleText = "Реестр проектов — LumenusTech";
    private const string PageDescription =
        "Завершённые и текущие проекты LumenusTech: on-premise LLM, RAG-системы, гибридные AI-платформы для организаций с закрытым контуром.";

    // JSON-LD: список проектов реестра
    private object JsonLd => new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "ItemList",
        ["name"] = "Реестр проектов LumenusTech",
        ["itemListElement"] = projects.Select((p, i) => new Dictionary<string, object>
        {
            ["@type"] = "ListItem",
            ["position"] = i + 1,
            ["url"] = SiteInfo.Url("/projects/" + p.Slug),
            ["item"] = new Dictionary<string, object>
            {
                ["@type"] = "CreativeWork",
                ["name"] = p.Title,
                ["url"] = SiteInfo.Url("/projects/" + p.Slug),
                ["description"] = p.Summary,
                ["about"] = p.Direction,
                ["dateCreated"] = p.Year.ToString(),
                ["creativeWorkStatus"] = p.Status,
                ["sourceOrganization"] = new Dictionary<string, object> { ["@type"] = "Organization", ["name"] = p.Client },
                ["creator"] = new Dictionary<string, object> { ["@type"] = "Organization", ["name"] = SiteInfo.Name, ["url"] = SiteInfo.BaseUrl + "/" },
            },
        }).ToList(),
    };

    private List<Project> projects = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        projects = await db.Projects.AsNoTracking()
            .Where(p => p.IsPublished)
            .OrderBy(p => p.SortOrder)
            .ThenBy(p => p.Id)
            .ToListAsync();
    }
}
