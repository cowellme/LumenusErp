@page "/tasks"
@using System.Security.Claims
@using LumenusErp.Data
@using LumenusErp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject TaskService Tasks
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Задачи — LumenusTech</PageTitle>

<section class="hero hero--sm">
    <div class="container">
        <p class="eyebrow">TASKS</p>
        <h1 class="hero__title mb-2">Мои задачи</h1>
        <p class="text-muted mb-0">Открытых: <strong>@openCount</strong>, выполненных: <strong>@doneCount</strong></p>
        <TasksTabs Active="tasks" />
    </div>
</section>

<section class="section section--tight">
    <div class="container" style="max-width: 820px;">
        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <form class="mb-4" @onsubmit="AddAsync">
            <div class="d-flex gap-2">
                <input class="form-control" @bind="newTitle" @bind:event="oninput" maxlength="@TaskService.MaxTitle"
                       placeholder="Новая задача" aria-label="Название новой задачи" />
                <button type="submit" class="btn btn-dark text-nowrap" disabled="@(string.IsNullOrWhiteSpace(newTitle))">Добавить</button>
            </div>
            <div class="d-flex flex-wrap gap-3 mt-2">
                @DateInput("Начало", newStartDate, newStartTime, v => newStartDate = v, v => newStartTime = v, () => { newStartDate = newStartTime = ""; })
                @DateInput("Дедлайн", newDueDate, newDueTime, v => newDueDate = v, v => newDueTime = v, () => { newDueDate = newDueTime = ""; })
            </div>
        </form>

        <div class="btn-group mb-3" role="group" aria-label="Фильтр задач">
            @foreach (var (value, label) in Filters)
            {
                <button type="button" class="btn btn-sm @(filter == value ? "btn-dark" : "btn-outline-dark")" @onclick="() => SetFilter(value)">@label</button>
            }
        </div>

        @if (!loaded)
        {
            <p class="text-muted">Загрузка…</p>
        }
        else if (shown.Count == 0)
        {
            <p class="text-muted">Задач нет.</p>
        }
        else
        {
            <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                @foreach (var t in shown)
                {
                    <li class="card-x p-3" @key="t.Id">
                        <div class="d-flex align-items-start gap-3">
                            <input type="checkbox" class="form-check-input mt-1 flex-shrink-0" style="width:1.25rem;height:1.25rem;"
                                   checked="@(t.Status == TaskItem.StatusDone)" @onchange="() => ToggleAsync(t)"
                                   aria-label="@(t.Status == TaskItem.StatusDone ? "Вернуть в открытые" : "Отметить выполненной")" />
                            <div class="flex-grow-1" style="min-width:0;">
                                @if (editId == t.Id)
                                {
                                    <input class="form-control" @ref="editInput" @bind="editTitle" @bind:event="oninput" maxlength="@TaskService.MaxTitle"
                                           @onkeydown="e => EditKeyAsync(e, t)" aria-label="Название задачи" />
                                    <div class="d-flex flex-wrap gap-3 mt-2">
                                        @DateInput("Начало", editStartDate, editStartTime, v => editStartDate = v, v => editStartTime = v, () => { editStartDate = editStartTime = ""; })
                                        @DateInput("Дедлайн", editDueDate, editDueTime, v => editDueDate = v, v => editDueTime = v, () => { editDueDate = editDueTime = ""; })
                                    </div>
                                    <div class="d-flex gap-2 mt-2">
                                        <button type="button" class="btn btn-dark btn-sm" @onclick="() => SaveEditAsync(t)">Сохранить</button>
                                        <button type="button" class="btn btn-outline-dark btn-sm" @onclick="CancelEdit">Отмена</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="fw-semibold" style="overflow-wrap:anywhere;@(t.Status == TaskItem.StatusDone ? "text-decoration:line-through;color:var(--c-muted);" : "")">@t.Title</div>
                                    <div class="small text-muted font-monospace mt-1">
                                        @FormatLocal(t.CreatedAt)
                                        @if (t.Source != TaskService.WebSource)
                                        {
                                            <span class="pill pill--tag ms-1">@t.Source</span>
                                        }
                                    </div>
                                    var dates = TaskDateFormat.Format(t.StartAt, t.DueAt, t.Status == TaskItem.StatusOpen, DateTime.UtcNow, utcOffsetMinutes);
                                    @if (dates.Start is not null || dates.Due is not null)
                                    {
                                        <div class="small mt-1">
                                            @if (dates.Start is not null)
                                            {
                                                <span>@dates.Start</span>
                                            }
                                            @if (dates.Start is not null && dates.Due is not null)
                                            {
                                                <span class="text-muted"> · </span>
                                            }
                                            @if (dates.Due is not null)
                                            {
                                                <span style="@(dates.Overdue ? "color:var(--c-danger);font-weight:600;" : "")">@dates.Due@(dates.Overdue ? " · просрочено" : "")</span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.SourceText))
                                    {
                                        <details class="mt-2">
                                            <summary class="small text-muted">Исходный текст</summary>
                                            <p class="small mb-0 mt-1" style="white-space:pre-wrap;overflow-wrap:anywhere;">@t.SourceText</p>
                                        </details>
                                    }
                                }
                            </div>
                        </div>
                        @if (editId != t.Id)
                        {
                            <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-2">
                                @if (confirmDeleteId == t.Id)
                                {
                                    <span class="small me-1">Удалить?</span>
                                    <button type="button" class="btn btn-dark btn-sm" @onclick="() => DeleteAsync(t)">Да</button>
                                    <button type="button" class="btn btn-outline-dark btn-sm" @onclick="() => confirmDeleteId = null">Нет</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-dark btn-sm" @onclick="() => StartEdit(t)">Изменить</button>
                                    <button type="button" class="btn btn-outline-dark btn-sm" @onclick="() => confirmDeleteId = t.Id">Удалить</button>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    // Поле срока: дата + необязательное время (без времени: начало 00:00, дедлайн 23:59) и очистка.
    private RenderFragment DateInput(string label, string date, string time, Action<string> setDate, Action<string> setTime, Action clear) => @<div>
        <label class="form-label small fw-bold mb-1">@label</label>
        <div class="d-flex align-items-center gap-1">
            <input type="date" class="form-control form-control-sm" style="width:auto;" value="@date" aria-label="@(label + ": дата")"
                   @onchange="e => setDate(e.Value?.ToString() ?? string.Empty)" />
            <input type="time" class="form-control form-control-sm" style="width:auto;" value="@time" aria-label="@(label + ": время")"
                   @onchange="e => setTime(e.Value?.ToString() ?? string.Empty)" />
            @if (date.Length > 0 || time.Length > 0)
            {
                <button type="button" class="btn btn-outline-dark btn-sm" aria-label="@(label + ": убрать")" @onclick="clear">×</button>
            }
        </div>
    </div>;

    private const string FilterOpen = "open", FilterDone = "done", FilterAll = "all";
    private static readonly (string Value, string Label)[] Filters =
        [(FilterOpen, "Открытые"), (FilterDone, "Выполненные"), (FilterAll, "Все")];

    private string? ownerId;
    private List<TaskItem> all = new();
    private string filter = FilterOpen;
    private string newTitle = "";
    private string? error;
    private bool loaded;
    private Guid? editId, confirmDeleteId;
    private string editTitle = "";
    private string newStartDate = "", newStartTime = "", newDueDate = "", newDueTime = "";
    private string editStartDate = "", editStartTime = "", editDueDate = "", editDueTime = "";
    private int utcOffsetMinutes;
    private ElementReference editInput;
    private bool focusEdit;

    // Открытые — по сроку (TaskDates.SortOpen); выполненные — как пришли из ListAsync (новые выше); «Все»: сначала открытые.
    private IEnumerable<TaskItem> Visible => filter switch
    {
        FilterOpen => TaskDates.SortOpen(all.Where(t => t.Status == TaskItem.StatusOpen)),
        FilterDone => all.Where(t => t.Status == TaskItem.StatusDone),
        _ => TaskDates.SortOpen(all.Where(t => t.Status == TaskItem.StatusOpen)).Concat(all.Where(t => t.Status == TaskItem.StatusDone)),
    };
    private List<TaskItem> shown = new();
    private int openCount => all.Count(t => t.Status == TaskItem.StatusOpen);
    private int doneCount => all.Count(t => t.Status == TaskItem.StatusDone);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        ownerId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusEdit)
        {
            focusEdit = false;
            await editInput.FocusAsync();
        }
        if (!firstRender) return;
        // Часовой пояс браузера: сервер его не знает.
        utcOffsetMinutes = await JS.InvokeAsync<int>("lmnTasks.utcOffsetMinutes");
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        if (ownerId is null) return;
        all = await Tasks.ListAsync(ownerId);
        loaded = true;
        Refilter();
    }

    private void Refilter() => shown = Visible.ToList();

    private void SetFilter(string value)
    {
        filter = value;
        Refilter();
    }

    private string FormatLocal(DateTime utc) => utc.AddMinutes(utcOffsetMinutes).ToString("dd.MM.yyyy HH:mm") + (utcOffsetMinutes == 0 ? " UTC" : "");

    private async Task AddAsync()
    {
        error = null;
        if (ownerId is null) return;
        if (!ParseDates(newStartDate, newStartTime, newDueDate, newDueTime, out var start, out var due)) return;
        var r = await Tasks.CreateManualAsync(ownerId, newTitle, start, due);
        if (r.Errors is not null)
        {
            error = r.Errors.ContainsKey("startAt") ? TaskDates.OrderError : $"Название: 1–{TaskService.MaxTitle} символов.";
            return;
        }
        newTitle = "";
        newStartDate = newStartTime = newDueDate = newDueTime = "";
        await ReloadAsync();
    }

    /// <summary>Поля ввода → UTC по смещению браузера; при ошибке выставляет error и возвращает false.</summary>
    private bool ParseDates(string startDate, string startTime, string dueDate, string dueTime, out DateTime? start, out DateTime? due)
    {
        start = due = null;
        if (!TaskDateFormat.TryFromInputs(startDate, startTime, false, utcOffsetMinutes, out start) ||
            !TaskDateFormat.TryFromInputs(dueDate, dueTime, true, utcOffsetMinutes, out due))
        {
            error = "Дата или время указаны неверно.";
            return false;
        }
        if (TaskDates.Validate(start, due) is { } order)
        {
            error = order;
            return false;
        }
        return true;
    }

    private async Task ToggleAsync(TaskItem t)
    {
        error = null;
        if (ownerId is null) return;
        var next = t.Status == TaskItem.StatusDone ? TaskItem.StatusOpen : TaskItem.StatusDone;
        await Tasks.SetStatusAsync(ownerId, t.Id, next);
        await ReloadAsync();
    }

    private void StartEdit(TaskItem t)
    {
        error = null;
        editId = t.Id;
        editTitle = t.Title;
        (editStartDate, editStartTime) = TaskDateFormat.ToInputs(t.StartAt, false, utcOffsetMinutes);
        (editDueDate, editDueTime) = TaskDateFormat.ToInputs(t.DueAt, true, utcOffsetMinutes);
        focusEdit = true;
    }

    private void CancelEdit() => editId = null;

    private async Task EditKeyAsync(KeyboardEventArgs e, TaskItem t)
    {
        if (e.Key == "Enter") await SaveEditAsync(t);
        else if (e.Key == "Escape") CancelEdit();
    }

    private async Task SaveEditAsync(TaskItem t)
    {
        error = null;
        if (ownerId is null) return;
        if (TaskService.NormalizeTitle(editTitle) is null)
        {
            error = $"Название: 1–{TaskService.MaxTitle} символов.";
            return;
        }
        if (!ParseDates(editStartDate, editStartTime, editDueDate, editDueTime, out var start, out var due)) return;
        await Tasks.RenameAsync(ownerId, t.Id, editTitle);
        await Tasks.SetDatesAsync(ownerId, t.Id, start, due);
        editId = null;
        await ReloadAsync();
    }

    private async Task DeleteAsync(TaskItem t)
    {
        error = null;
        if (ownerId is null) return;
        await Tasks.DeleteAsync(ownerId, t.Id);
        confirmDeleteId = null;
        await ReloadAsync();
    }
}
