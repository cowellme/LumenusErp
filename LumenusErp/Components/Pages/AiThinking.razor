@* AiThinkingParticles.razor *@
<div class="ai-thinking-particles">
    <div class="particle-core">
        <div class="particle p1"></div>
        <div class="particle p2"></div>
        <div class="particle p3"></div>
        <div class="particle p4"></div>
        <div class="particle p5"></div>
        <div class="particle p6"></div>
        <div class="center-brain">
            <i class="bi bi-cpu"></i>
        </div>
    </div>
    <span class="ai-static-text">Анализирую запрос</span>
</div>

<style>
    .ai-thinking-particles {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.5rem;
        background: #ffffff;
        border-radius: 60px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.06);
        animation: fadeInScale 0.4s ease;
        width: fit-content;
    }

    @@keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    .particle-core {
        position: relative;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
    }

    .center-brain {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 1.1rem;
        color: #6366f1;
        z-index: 10;
        animation: subtlePulse 2s ease-in-out infinite;
    }

    @@keyframes subtlePulse {
        0%, 100% { opacity: 0.7; }
        50% { opacity: 1; }
    }

    .particle {
        position: absolute;
        width: 5px;
        height: 5px;
        background: #818cf8;
        border-radius: 50%;
        top: 50%;
        left: 50%;
        animation: particleOrbit 2.5s linear infinite;
        box-shadow: 0 0 8px rgba(99, 102, 241, 0.6);
    }

    .p1 { animation-delay: 0s; }
    .p2 { animation-delay: -0.4s; }
    .p3 { animation-delay: -0.8s; }
    .p4 { animation-delay: -1.2s; }
    .p5 { animation-delay: -1.6s; }
    .p6 { animation-delay: -2.0s; }

    @@keyframes particleOrbit {
        0% {
            transform: translate(-50%, -50%) rotate(0deg) translateX(18px) rotate(0deg);
        }
        100% {
            transform: translate(-50%, -50%) rotate(360deg) translateX(18px) rotate(-360deg);
        }
    }

    .ai-static-text {
        color: #4c1d95;
        font-weight: 500;
        font-size: 0.95rem;
        white-space: nowrap;
        letter-spacing: 0.2px;
        position: relative;
    }

    /* Три точки с анимацией появления/исчезания */
    .ai-static-text::after {
        content: '';
        display: inline-block;
        animation: dotsFade 1.5s steps(4, end) infinite;
        vertical-align: baseline;
        margin-left: 1px;
    }

    @@keyframes dotsFade {
        0%   { content: ''; }
        25%  { content: '.'; }
        50%  { content: '..'; }
        75%  { content: '...'; }
        100% { content: ''; }
    }

    /* Альтернативно, если ::after с content не работает в Blazor, используем отдельные span'ы */
</style>