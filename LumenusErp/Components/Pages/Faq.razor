@page "/faq"
@using LumenusErp.Services
<PageTitle>@PageTitleText</PageTitle>
<SeoMeta Path="/faq" Title="@PageTitleText" Description="@PageDescription" />

@* ======================================================================== *@
@*  HERO                                                                   *@
@* ======================================================================== *@
<section class="faq-hero" aria-labelledby="faq-title">
    <div class="container">
        <p class="faq-hero__tag">СПРАВКА</p>
        <h1 id="faq-title" class="faq-hero__title">Часто задаваемые вопросы</h1>
        <p class="faq-hero__subtitle">
            Ответы о системе, развёртывании и безопасности.
            Если не нашли нужного — задайте вопрос AI-ассистенту.
        </p>
        <div class="faq-hero__chips">
            <span class="faq-chip">Telegram интеграция</span>
            <span class="faq-chip">Локальное решение</span>
            <span class="faq-chip">Постоянная поддержка</span>
        </div>
    </div>
</section>

@* ======================================================================== *@
@*  SEARCH                                                                  *@
@* ======================================================================== *@
<section class="faq-assistant" aria-label="Вопрос AI-ассистенту">
    @* Интерактивный островок: страница статическая, цепь Blazor нужна только ему *@
    <FaqAssistant @rendermode="InteractiveServer" />
</section>

@* ======================================================================== *@
@*  CONTACT                                                                 *@
@* ======================================================================== *@
<section class="faq-contact" aria-labelledby="contact-title">
    <div class="container text-center">
        <p class="faq-contact__tag">ПОДДЕРЖКА</p>
        <h2 id="contact-title" class="faq-contact__title">Остались вопросы?</h2>
        <p class="faq-contact__subtitle">
            Свяжитесь напрямую — ответим в течение рабочего дня.
        </p>
        <div class="faq-contact__actions">
            <a href="mailto:info@lumenustech.ru" class="btn btn-dark btn-lg">
                info@lumenustech.ru
            </a>
            <a href="@SiteInfo.TelegramUrl" class="btn btn-outline-dark btn-lg">
                Telegram
            </a>
        </div>
    </div>
</section>

@code {
    private const string PageTitleText = "FAQ — LumenusTech";
    private const string PageDescription =
        "Частые вопросы о системе, развёртывании и безопасности. Задайте вопрос AI-ассистенту LumenusTech или свяжитесь с нами напрямую.";
}
