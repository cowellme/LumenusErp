@page "/calculator"
<PageTitle>@PageTitleText</PageTitle>
<SeoMeta Path="/calculator" Title="@PageTitleText" Description="@PageDescription" />


        @* ======================================================================== *@
        @*  HERO                                                                   *@
        @* ======================================================================== *@
        <section class="hero hero--sm">
            <div class="container">
                <p class="eyebrow">КАЛЬКУЛЯТОР</p>
                <h1 class="hero__title mb-3">Рассчитайте стоимость проекта</h1>
                <p class="hero__lead mb-0">
                    Опишите задачу — AI-ассистент оценит объём работ, стек и примерный бюджет.
                    После расчёта мы свяжемся с вами для уточнения деталей.
                </p>
            </div>
        </section>

        @* ======================================================================== *@
        @*  FORM                                                                    *@
        @* ======================================================================== *@
        <section class="section section--tight">
            @* Интерактивный островок: страница статическая, цепь Blazor нужна только форме *@
            <CalculatorForm @rendermode="InteractiveServer" />
        </section>


@code {
    private const string PageTitleText = "Расчёт стоимости проекта — LumenusTech";
    private const string PageDescription =
        "Калькулятор LumenusTech: опишите задачу, и AI-ассистент оценит объём работ, стек, сроки и примерный бюджет внедрения.";
}
