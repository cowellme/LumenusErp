@page "/calculator"
@rendermode InteractiveServer
@using LumenusErp.Services
@using Newtonsoft.Json
@using LumenusErp.Components.Tools
@inject ILogger<Calculator> Logger
<PageTitle>Расчёт стоимости — LumenusTech</PageTitle>


<AuthorizeView>
    <Authorized>

        @* ======================================================================== *@
        @*  HERO                                                                   *@
        @* ======================================================================== *@
        <section class="hero hero--sm">
            <div class="container">
                <p class="eyebrow">КАЛЬКУЛЯТОР</p>
                <h1 class="hero__title mb-3">Рассчитайте стоимость проекта</h1>
                <p class="hero__lead mb-0">
                    Опишите задачу — AI-ассистент оценит объём работ, стек и примерный бюджет.
                    После расчёта мы свяжемся с вами для уточнения деталей.
                </p>
            </div>
        </section>

        @* ======================================================================== *@
        @*  FORM                                                                    *@
        @* ======================================================================== *@
        <section class="section section--tight">
            <div class="container">
                <div class="card-x form-card">

                    @* ── Quick chips ────────────────────────────────────────── *@
                    <div class="d-flex flex-wrap align-items-center gap-2 pb-4 mb-4 border-bottom">
                        <span class="field-label mb-0 me-1">ЧАСТЫЕ ЗАДАЧИ:</span>
                        <span class="small text-muted me-1" style="font-size:0.72rem;">необязательно</span>
                        @foreach (var chip in quickChips)
                        {
                            <button type="button"
                                    class="btn @(selectedChip == chip.Label ? "btn-dark" : "btn-outline-dark") rounded-pill btn-sm fw-semibold"
                                    style="font-size:0.78rem;"
                                    @onclick="() => SelectChip(chip.Label)">
                                @chip.Label
                            </button>
                        }
                    </div>

                    @* ── Textarea ───────────────────────────────────────────── *@
                    <div class="mb-4">
                        <label class="field-label" for="project-desc">
                            ОПИШИТЕ ВАШ ПРОЕКТ
                        </label>
                        <textarea id="project-desc"
                                  class="form-control"
                                  style="resize:vertical; font-size:0.9rem;"
                                  rows="14"
                                  placeholder="Пример:&#10;&#10;Производственная компания, 200 сотрудников. Нужно анализировать внутреннюю переписку в Telegram и корпоративную почту на предмет утечек коммерческой информации. Данные нельзя отправлять в облако — всё должно быть развёрнуто локально. Бюджет ориентировочно до 2 млн руб., сроки — 2–3 месяца."
                                  @bind="description"
                                  @bind:event="oninput"
                                  disabled="@isLoading"></textarea>
                        <div class="form-text small mt-1" style="font-size:0.72rem; color:#888;">
                            Чем подробнее описание — тем точнее оценка. Укажите масштаб, тип данных, требования к безопасности, бюджетные и временные рамки.
                        </div>
                    </div>

                    @* ── Contacts ───────────────────────────────────────────── *@
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="field-label" for="contact-name">
                                КАК К ВАМ ОБРАЩАТЬСЯ
                            </label>
                            <input type="text" id="contact-name"
                                   class="form-control"
                                   placeholder="Иван Петров"
                                   disabled="@isLoading"
                                   @bind="contactName" />
                        </div>
                        <div class="col-md-6">
                            <label class="field-label" for="contact-tg">
                                TELEGRAM ИЛИ ПОЧТА
                            </label>
                            <input type="text" id="contact-tg"
                                   class="form-control"
                                   placeholder="@@username или email@example.com"
                                   disabled="@isLoading"
                                   @bind="contactContact" />
                        </div>
                    </div>

                    @* ── Submit ─────────────────────────────────────────────── *@
                    <button type="button"
                            class="btn btn-dark btn-lg w-100"
                            disabled="@(isLoading || string.IsNullOrWhiteSpace(description))"
                            @onclick="SubmitAsync">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>AI АНАЛИЗИРУЕТ ПРОЕКТ</span>
                        }
                        else
                        {
                            <span>ОТПРАВИТЬ НА ОЦЕНКУ AI</span>
                        }
                    </button>
                </div>

                @* ── RESULT ────────────────────────────────────────────────── *@
                @if (result != null || rawResult != null)
                {
                    <div class="card-x form-card p-0 mt-4 overflow-hidden">
                        <div class="bg-dark text-white px-4 py-3 d-flex align-items-center justify-content-between">
                            <span class="font-monospace small fw-bold text-uppercase" style="letter-spacing:0.08em;">ОЦЕНКА AI-АССИСТЕНТА</span>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => { result = null; rawResult = null; }" title="Закрыть" style="font-size:0.7rem;"></button>
                        </div>
                        <div class="p-4 p-md-5">
                            @if (result != null)
                            {
                                @if (!string.IsNullOrWhiteSpace(result.Summary))
                                {
                                    <p class="mb-4">@result.Summary</p>
                                }

                                <div class="row g-3 pb-4 mb-4 border-bottom">
                                    <div class="col text-center border rounded-3 p-3">
                                        <span class="d-block eyebrow mb-1">БЮДЖЕТ</span>
                                        <span class="fw-bold">@result.EstimatedBudget</span>
                                    </div>
                                    <div class="col text-center border rounded-3 p-3">
                                        <span class="d-block eyebrow mb-1">СРОК</span>
                                        <span class="fw-bold">@result.EstimatedTimeline</span>
                                    </div>
                                    <div class="col text-center border rounded-3 p-3">
                                        <span class="d-block eyebrow mb-1">СТЕК</span>
                                        <span class="fw-bold">@result.RecommendedStack</span>
                                    </div>
                                </div>

                                <MarkdownViewer Content="@result.Detail" />
                            }
                            else
                            {
                                <MarkdownViewer Content="@rawResult" />
                            }

                        </div>
                    </div>
                }

                @* ── ERROR ──────────────────────────────────────────────────── *@
                @if (errorMessage != null)
                {
                    <div class="alert alert-danger d-flex align-items-center mt-4 mb-0" role="alert">
                        <span>@errorMessage</span>
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-0 ms-auto fw-bold font-monospace text-uppercase"
                                style="font-size:0.7rem; letter-spacing:0.06em;"
                                @onclick="() => errorMessage = null">
                            ПОВТОРИТЬ
                        </button>
                    </div>
                }
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="hero hero--sm">
            <div class="container">
                <p class="text-muted" style="max-width: 580px;">
                    Пожалуйста войдите в систему!
                </p>
                <NavLink class="btn btn-dark" href="Account/Login">
                    Вход
                </NavLink>
            </div>
        </section>
        
    </NotAuthorized>
</AuthorizeView>


@code {
    private string description = string.Empty;
    private string contactName = string.Empty;
    private string contactContact = string.Empty;
    private string selectedChip = string.Empty;
    private bool isLoading;
    private string? errorMessage;
    private EstimateResult? result;
    private string? rawResult;

    private readonly List<ChipItem> quickChips = new()
    {
        new("RAG-система", "Нужна RAG-система для анализа документов"),
        new("Мониторинг", "Нужен мониторинг переписок и звонков сотрудников"),
        new("On-Premise LLM", "Нужно развернуть LLM локально"),
        new("Интеграция с CRM", "Нужна интеграция AI с учётными системами"),
        new("Шифрование ПДн", "Нужна защита персональных данных в AI-пайплайне"),
    };

    private void SelectChip(string chip)
    {
        if (isLoading) return;
        // Повторный клик снимает тему; текст пользователя не трогаем
        selectedChip = selectedChip == chip ? string.Empty : chip;
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(description)) return;
        isLoading = true;
        errorMessage = null;
        result = null;
        rawResult = null;

        try
        {
            var prompt = string.IsNullOrEmpty(selectedChip)
                ? description
                : $"Тема: {selectedChip}\n\n{description}";

            var responseRaw = await AiModule.EstimateProjectAsync(prompt);

            result = ParseEstimate(responseRaw);
            if (result == null)
                rawResult = responseRaw;
        }
        catch (AiNotConfiguredException ex)
        {
            Logger.LogError(ex, "[Calculator] AI is not configured");
            errorMessage = "Сервис оценки временно недоступен. Свяжитесь с нами напрямую через Telegram.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Calculator] Estimate failed");
            errorMessage = "Не удалось выполнить оценку. Попробуйте позже или свяжитесь напрямую через Telegram.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static EstimateResult? ParseEstimate(string raw)
    {
        try
        {
            var json = ExtractJson(raw);
            if (json != null)
            {
                var structured = JsonConvert.DeserializeObject<EstimateResult>(json);
                if (structured != null && !string.IsNullOrWhiteSpace(structured.Detail ?? structured.Summary))
                    return structured;
            }
        }
        catch (JsonException)
        {
            // Не JSON: покажем сырой текст
        }

        return null;
    }

    private static string? ExtractJson(string raw)
    {
        var fenceStart = raw.IndexOf("```json", StringComparison.OrdinalIgnoreCase);
        if (fenceStart >= 0)
        {
            fenceStart = raw.IndexOf('\n', fenceStart) + 1;
            var fenceEnd = raw.IndexOf("```", fenceStart, StringComparison.Ordinal);
            if (fenceEnd > fenceStart)
                return raw[fenceStart..fenceEnd].Trim();
        }

        var braceStart = raw.IndexOf('{');
        var braceEnd = raw.LastIndexOf('}');
        if (braceStart >= 0 && braceEnd > braceStart)
            return raw[braceStart..(braceEnd + 1)];

        return null;
    }

    private sealed record ChipItem(string Label, string Template);

    private sealed record EstimateResult(
        string Summary,
        string EstimatedBudget,
        string EstimatedTimeline,
        string RecommendedStack,
        string Detail
    );

    private sealed class StructuredEstimate
    {
        [JsonProperty("summary")] public string? Summary { get; set; }
        [JsonProperty("estimated_budget")] public string? EstimatedBudget { get; set; }
        [JsonProperty("estimated_timeline")] public string? EstimatedTimeline { get; set; }
        [JsonProperty("recommended_stack")] public string? RecommendedStack { get; set; }
    }
}