@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100">
    @* ── HEADER ────────────────────────────────────────────────── *@
    <header class="bg-white border-bottom border-dark border-2 sticky-top">
        <div class="container-fluid d-flex align-items-center px-3" style="height: 52px; max-width: 1280px;">
            @* Brand *@
            <a href="/" class="font-monospace fw-bold small text-dark text-uppercase text-decoration-none flex-shrink-0 me-4">
                Lunenus<span class="fw-extrabold text-muted">Uam</span>
            </a>

            @* Navigation *@
            <NavMenu />

            @* Right side *@
            <div class="d-flex align-items-center gap-3 ms-auto flex-shrink-0">
                <a href="/faq" class="text-dark fw-semibold small text-decoration-none d-none d-md-inline">FAQ</a>

                <span class="font-monospace small fw-semibold text-muted d-none d-md-inline-flex align-items-center gap-1">
                    <span class="d-inline-block bg-dark" style="width:8px;height:8px;"></span>
                    ONLINE
                </span>

                @* Mobile burger *@
                <button class="d-md-none btn btn-outline-dark rounded-0 border-2 p-1" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mobileNav"
                        aria-expanded="false" aria-controls="mobileNav" aria-label="Меню">
                    <span class="navbar-toggler-icon" style="width:1.2em; height:1.2em;"></span>
                </button>
            </div>
        </div>
    </header>

    @* ── CONTENT ───────────────────────────────────────────────── *@
    <main class="flex-grow-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="position-fixed bottom-0 end-0 m-3 p-3 bg-white border border-danger border-2 font-monospace small text-danger d-none">
    An unhandled error has occurred.
    <a href="." class="fw-bold text-dark">Reload</a>
    <span class="ms-2 text-muted" style="cursor:pointer" onclick="this.parentElement.style.display='none'">✕</span>
</div>