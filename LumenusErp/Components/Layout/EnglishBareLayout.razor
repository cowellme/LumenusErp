@inherits LayoutComponentBase

@* Лендинг и вход English Studio: без меню кабинета и без шапки сайта. *@
<div class="es-app" data-bs-theme="light">
    @Body
</div>

<div id="blazor-error-ui" class="position-fixed bottom-0 end-0 m-3 p-3 bg-body border border-danger border-2 font-monospace small text-danger d-none">
    An unhandled error has occurred.
    <a href="." class="fw-bold text-body">Reload</a>
    <span class="ms-2 text-muted" style="cursor:pointer" onclick="this.parentElement.style.display='none'">✕</span>
</div>
