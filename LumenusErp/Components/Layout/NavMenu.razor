@implements IDisposable

@inject NavigationManager NavigationManager

@* ── Desktop nav ───────────────────────────────────────────────────── *@
<nav class="d-none d-md-flex align-items-center flex-grow-1">
    @* Left links *@
    <div class="d-flex align-items-center">
        <NavLink class="nav-link px-3 py-2 text-dark fw-semibold small text-decoration-none" href="" Match="NavLinkMatch.All">
            Главная
        </NavLink>
        <NavLink class="nav-link px-3 py-2 text-dark fw-semibold small text-decoration-none" href="projects">
            Проекты
        </NavLink>
        <AuthorizeView>
            <Authorized>

                <NavLink class="nav-link px-3 py-2 text-dark fw-semibold small text-decoration-none" href="calculator">
                    Калькулятор
                </NavLink>

            </Authorized>
        </AuthorizeView>
    </div>

    @* Right auth *@
    <div class="d-flex align-items-center ms-auto">
        <AuthorizeView Roles="Admin, Aos">
            
            <NavLink class="nav-link px-3 py-2 text-dark fw-semibold small text-decoration-none" href="aos-panel">
                Мой проект
            </NavLink>

        </AuthorizeView>
        <AuthorizeView>
            <Authorized>

                <NavLink class="nav-link px-3 py-2 text-dark fw-semibold small d-flex align-items-center gap-2 text-decoration-none" href="Account/Manage">
                    Аккаунт @* @context.User.Identity?.Name *@
                </NavLink>

                <form action="Account/Logout" method="post" class="m-0">
                    <AntiforgeryToken/>
                    <input type="hidden" name="ReturnUrl" value="@currentUrl"/>
                    <button type="submit" class="nav-link px-3 py-2 text-danger fw-semibold small text-decoration-none">
                        Выход
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>

                <NavLink class="nav-link px-3 py-2 border-start border-dark border-2 text-dark fw-semibold small text-decoration-none" href="Account/Login">
                    Вход
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>


@code {
    private string? currentUrl;
    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }


}