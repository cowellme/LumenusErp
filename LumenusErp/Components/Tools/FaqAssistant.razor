@using LumenusErp.Services
@inherits AiPageBase

<div class="faq-search">
    <div class="container">
        <div class="faq-search__row">
            <div class="faq-search__input-wrap">
                <span class="faq-search__icon">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="2"/>
                        <line x1="11.5" y1="11.5" x2="16" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </span>
                <input type="text"
                       class="faq-search__input"
                       placeholder="Напишите ваш вопрос..."
                       aria-label="Ваш вопрос AI-ассистенту"
                       maxlength="@AiInputLimits.FaqMaxChars"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button class="faq-search__clear" @onclick="ClearSearch" type="button" title="Очистить">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </button>
                }
                <button class="faq-search__submit" @onclick="AskQuestion" type="button"
                        disabled="@(string.IsNullOrWhiteSpace(searchQuery) || isThinking)">
                    СПРОСИТЬ
                </button>
            </div>
        </div>
    </div>
</div>

<div class="faq-response" role="region" aria-label="Ответ AI-ассистента" aria-live="polite">
    <div class="container">
        @if (isThinking)
        {
            <div class="faq-response__thinking">
                <span class="faq-response__thinking-dot"></span>
                <span>AI-ассистент анализирует вопрос</span>
                <span class="faq-response__thinking-ellipsis">...</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(response))
        {
            <div class="faq-response__card">
                <div class="faq-response__card-head">
                    <span>ОТВЕТ AI-АССИСТЕНТА</span>
                    <button class="faq-response__card-close" @onclick="ClearResponse" title="Закрыть">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <div class="faq-response__card-body">
                    <MarkdownViewer Content="@response" Safe="true" />
                    @if (showTelegramLink)
                    {
                        <p class="mb-0 mt-3"><a href="@SiteInfo.TelegramUrl" target="_blank" rel="noopener">Написать в Telegram</a></p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string searchQuery = string.Empty;
    private string response = string.Empty;
    private bool isThinking;
    private bool showTelegramLink;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery) && !isThinking)
        {
            await AskQuestion();
        }
    }

    private async Task AskQuestion()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || isThinking) return;

        isThinking = true;
        await InvokeAsync(StateHasChanged);

        showTelegramLink = false;
        var limit = await TryAcquireAsync(AiKind.Faq);
        if (!limit.IsAllowed)
        {
            response = LimitMessage(limit);
            showTelegramLink = limit.Status == AiLimitStatus.GloballyLimited;
        }
        else
        {
            // maxlength в разметке обходится, поэтому длину ограничиваем и на сервере
            var question = searchQuery.Trim();
            if (question.Length > AiInputLimits.FaqMaxChars)
                question = question[..AiInputLimits.FaqMaxChars];

            var responseRaw = await AiModule.SendQuestionFaq(question);
            response = string.IsNullOrEmpty(responseRaw)
                ? "Не удалось сгенерировать ответ. Попробуйте переформулировать вопрос."
                : responseRaw;
        }

        isThinking = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
    }

    private void ClearResponse()
    {
        response = string.Empty;
        showTelegramLink = false;
    }
}